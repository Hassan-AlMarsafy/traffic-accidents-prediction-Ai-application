    "# Grid Search for Hyperparameter Tuning (XGBoost - Cluster-based)\n",
    "from sklearn.model_selection import GridSearchCV\n",
    "\n",
    "# Define parameter grid\n",
    "param_grid_xgb = {\n",
    "    'n_estimators': [200, 500, 800],\n",
    "    'max_depth': [3, 6, 10],\n",
    "    'learning_rate': [0.01, 0.05, 0.1],\n",
    "    'subsample': [0.6, 0.8, 1.0],\n",
    "    'colsample_bytree': [0.6, 0.8, 1.0],\n",
    "    'min_child_weight': [1, 3, 5],\n",
    "    'gamma': [0, 0.1, 0.3]\n",
    "}\n",
    "\n",
    "# Initialize XGBClassifier\n",
    "xgb_grid = xgb.XGBClassifier(\n",
    "    objective='multi:softprob',\n",
    "    num_class=len(np.unique(y_train_c)),\n",
    "    random_state=42,\n",
    "    n_jobs=-1,\n",
    "    tree_method=\"hist\"  # faster training\n",
    ")\n",
    "\n",
    "# GridSearchCV setup\n",
    "grid_search_xgb = GridSearchCV(\n",
    "    estimator=xgb_grid,\n",
    "    param_grid=param_grid_xgb,\n",
    "    scoring='accuracy',\n",
    "    cv=3,                # 3-fold CV for speed (can increase to 5 if dataset is small)\n",
    "    n_jobs=-1,\n",
    "    verbose=2\n",
    ")\n",
    "\n",
    "# Run grid search\n",
    "grid_search_xgb.fit(X_train_xgb, y_train_c)\n",
    "\n",
    "# Best parameters and score\n",
    "print(\"Best Parameters found by Grid Search (XGBoost - Cluster-based):\")\n",
    "print(grid_search_xgb.best_params_)\n",
    "\n",
    "print(f\"\\nBest Cross-Validation Accuracy: {grid_search_xgb.best_score_:.4f}\")\n",
    "\n",
    "# Evaluate best model on test set\n",
    "best_xgb = grid_search_xgb.best_estimator_\n",
    "y_pred_best_xgb = best_xgb.predict(X_test_xgb)\n",
    "y_proba_best_xgb = best_xgb.predict_proba(X_test_xgb)\n",
    "\n",
    "print(\"\\nClassification Report (Best XGBoost Cluster-based Model):\")\n",
    "print(classification_report(y_test_c, y_pred_best_xgb))\n",
    "\n",
    "test_accuracy_xgb = accuracy_score(y_test_c, y_pred_best_xgb)\n",
    "print(f\"Test Accuracy with Tuned XGBoost Model: {test_accuracy_xgb:.4f}\")\n",
    "\n",
    "# Confusion Matrix for tuned XGB\n",
    "cm_best_xgb = confusion_matrix(y_test_c, y_pred_best_xgb)\n",
    "plt.figure(figsize=(8, 6))\n",
    "sns.heatmap(cm_best_xgb, annot=True, fmt='d', cmap='Blues',\n",
    "            xticklabels=[f'Severity {i}' for i in range(len(np.unique(y_test_c)))],\n",
    "            yticklabels=[f'Severity {i}' for i in range(len(np.unique(y_test_c)))])\n",
    "plt.xlabel('Predicted')\n",
    "plt.ylabel('Actual')\n",
    "plt.title('Confusion Matrix (Tuned XGBoost - Cluster-based)')\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
   ]
