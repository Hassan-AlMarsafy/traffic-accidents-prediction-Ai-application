    "# MODEL EXTRACTION CELL\n",
    "# Run this cell to save trained models as pkl/h5 files\n",
    "# Note: Make sure to run the model training cells first!\n",
    "\n",
    "import joblib\n",
    "import pickle\n",
    "import os\n",
    "from datetime import datetime\n",
    "import sys\n",
    "\n",
    "# Create models directory\n",
    "models_dir = \"saved_models\"\n",
    "os.makedirs(models_dir, exist_ok=True)\n",
    "timestamp = datetime.now().strftime(\"%Y%m%d_%H%M%S\")\n",
    "\n",
    "print(\"🔍 CHECKING FOR TRAINED MODELS...\")\n",
    "print(\"=\" * 50)\n",
    "\n",
    "# Check which models exist in memory\n",
    "models_found = {}\n",
    "model_variables = [\n",
    "    ('rf_model', 'Random Forest (Cluster-based)'),\n",
    "    ('rf_model_z', 'Random Forest (Zone-based)'), \n",
    "    ('xgb_model', 'XGBoost Model (Cluster-based'),\n",
    "\n",
    "    ('xgb_model_z', 'XGBoost (Zone-based)')\n",
    "]\n",
    "\n",
    "for var_name, description in model_variables:\n",
    "    if var_name in globals():\n",
    "        models_found[var_name] = {\n",
    "            'description': description,\n",
    "            'model': globals()[var_name],\n",
    "            'type': type(globals()[var_name]).__name__\n",
    "        }\n",
    "        print(f\"✅ Found: {description} ({var_name})\")\n",
    "    else:\n",
    "        print(f\"❌ Not found: {description} ({var_name})\")\n",
    "\n",
    "print(f\"\\n📊 TOTAL MODELS FOUND: {len(models_found)}\")\n",
    "\n",
    "if len(models_found) == 0:\n",
    "    print(\"\\n⚠️  NO TRAINED MODELS FOUND!\")\n",
    "    print(\"\\nTo train models, please run these cells in order:\")\n",
    "    print(\"1. Import libraries cell (usually cell 2)\")\n",
    "    print(\"2. Data loading cells\")\n",
    "    print(\"3. Data preprocessing cells\") \n",
    "    print(\"4. Random Forest training cell (~line 324)\")\n",
    "    print(\"5. Zone-based Random Forest cell (~line 462)\")\n",
    "    print(\"6. XGBoost training cells (~line 758)\")\n",
    "    print(\"\\nThen re-run this extraction cell.\")\n",
    "else:\n",
    "    print(\"\\n💾 SAVING MODELS...\")\n",
    "    print(\"=\" * 30)\n",
    "    \n",
    "    saved_files = []\n",
    "    \n",
    "    # Save each model\n",
    "    for var_name, info in models_found.items():\n",
    "        try:\n",
    "            model = info['model']\n",
    "            description = info['description']\n",
    "            \n",
    "            # Determine save method based on model type\n",
    "            if 'xgb' in var_name.lower():\n",
    "                # Handle XGBoost models\n",
    "                try:\n",
    "                    import xgboost as xgb\n",
    "                    if hasattr(model, 'save_model'):\n",
    "                        # Native XGBoost model\n",
    "                        filename = f\"{var_name}_{timestamp}.json\"\n",
    "                        filepath = os.path.join(models_dir, filename)\n",
    "                        model.save_model(filepath)\n",
    "                        method = \"XGBoost native (JSON)\"\n",
    "                    else:\n",
    "                        # Sklearn XGBoost wrapper\n",
    "                        filename = f\"{var_name}_{timestamp}.pkl\"\n",
    "                        filepath = os.path.join(models_dir, filename)\n",
    "                        joblib.dump(model, filepath)\n",
    "                        method = \"Joblib (PKL)\"\n",
    "                except:\n",
    "                    # Fallback to joblib\n",
    "                    filename = f\"{var_name}_{timestamp}.pkl\"\n",
    "                    filepath = os.path.join(models_dir, filename)\n",
    "                    joblib.dump(model, filepath)\n",
    "                    method = \"Joblib (PKL)\"\n",
    "            else:\n",
    "                # Save other models (Random Forest, etc.) with joblib\n",
    "                filename = f\"{var_name}_{timestamp}.pkl\"\n",
    "                filepath = os.path.join(models_dir, filename)\n",
    "                joblib.dump(model, filepath)\n",
    "                method = \"Joblib (PKL)\"\n",
    "            \n",
    "            # Get file size\n",
    "            size_mb = os.path.getsize(filepath) / (1024 * 1024)\n",
    "            \n",
    "            saved_files.append({\n",
    "                'name': var_name,\n",
    "                'description': description,\n",
    "                'filepath': filepath,\n",
    "                'method': method,\n",
    "                'size_mb': round(size_mb, 2)\n",
    "            })\n",
    "            \n",
    "            print(f\"✅ {description}\")\n",
    "            print(f\"   File: {filename}\")\n",
    "            print(f\"   Size: {size_mb:.2f} MB\")\n",
    "            print(f\"   Method: {method}\")\n",
    "            print()\n",
    "            \n",
    "        except Exception as e:\n",
    "            print(f\"❌ Failed to save {description}: {str(e)}\")\n",
    "    \n",
    "    # Save encoders if they exist\n",
    "    print(\"🔧 CHECKING FOR ENCODERS...\")\n",
    "    encoder_variables = ['encoders', 'encoders_xgb', 'le', 'label_encoder']\n",
    "    \n",
    "    for enc_name in encoder_variables:\n",
    "        if enc_name in globals():\n",
    "            try:\n",
    "                enc_filename = f\"encoder_{enc_name}_{timestamp}.pkl\"\n",
    "                enc_filepath = os.path.join(models_dir, enc_filename)\n",
    "                joblib.dump(globals()[enc_name], enc_filepath)\n",
    "                print(f\"✅ Saved encoder: {enc_name}\")\n",
    "            except Exception as e:\n",
    "                print(f\"❌ Failed to save encoder {enc_name}: {str(e)}\")\n",
    "    \n",
    "    # Create summary file\n",
    "    summary_file = os.path.join(models_dir, f\"extraction_summary_{timestamp}.txt\")\n",
    "    with open(summary_file, 'w') as f:\n",
    "        f.write(f\"MODEL EXTRACTION SUMMARY\\n\")\n",
    "        f.write(f\"Generated: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}\\n\")\n",
    "        f.write(\"=\" * 60 + \"\\n\\n\")\n",
    "        \n",
    "        for file_info in saved_files:\n",
    "            f.write(f\"Model: {file_info['description']}\\n\")\n",
    "            f.write(f\"Variable: {file_info['name']}\\n\") \n",
    "            f.write(f\"File: {os.path.basename(file_info['filepath'])}\\n\")\n",
    "            f.write(f\"Size: {file_info['size_mb']} MB\\n\")\n",
    "            f.write(f\"Method: {file_info['method']}\\n\")\n",
    "            f.write(\"-\" * 40 + \"\\n\")\n",
    "        \n",
    "        # Add loading instructions\n",
    "        f.write(\"\\nLOADING INSTRUCTIONS:\\n\")\n",
    "        f.write(\"To load these models in a new session:\\n\\n\")\n",
    "        f.write(\"import joblib\\n\")\n",
    "        f.write(\"import xgboost as xgb\\n\\n\")\n",
    "        \n",
    "        for file_info in saved_files:\n",
    "            if 'JSON' in file_info['method']:\n",
    "                f.write(f\"# Load {file_info['description']}\\n\")\n",
    "                f.write(f\"{file_info['name']} = xgb.Booster()\\n\")\n",
    "                f.write(f\"{file_info['name']}.load_model('{os.path.basename(file_info['filepath'])}')\\n\\n\")\n",
    "            else:\n",
    "                f.write(f\"# Load {file_info['description']}\\n\")\n",
    "                f.write(f\"{file_info['name']} = joblib.load('{os.path.basename(file_info['filepath'])}')\\n\\n\")\n",
    "    \n",
    "    print(f\"📄 Summary saved to: {summary_file}\")\n",
    "    \n",
    "    # Final summary\n",
    "    print(\"\\n🎉 EXTRACTION COMPLETED!\")\n",
    "    print(\"=\" * 40)\n",
    "    print(f\"📁 Models directory: {os.path.abspath(models_dir)}\")\n",
    "    print(f\"📊 Models saved: {len(saved_files)}\")\n",
    "    print(f\"💾 Total size: {sum(f['size_mb'] for f in saved_files):.2f} MB\")\n",
    "    \n",
    "    # Show file list\n",
    "    print(\"\\n📋 FILES CREATED:\")\n",
    "    for file_info in saved_files:\n",
    "        print(f\"  • {os.path.basename(file_info['filepath'])} ({file_info['size_mb']} MB)\")\n",
    "\n",
    "print(\"\\n\" + \"=\"*60)"
