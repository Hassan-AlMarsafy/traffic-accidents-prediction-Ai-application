    "    'max_features': ['sqrt', 'log2']\n",
    "}\n",
    "\n",
    "# Initialize Random Forest with class balancing\n",
    "rf_grid_z = RandomForestClassifier(random_state=42, class_weight='balanced')\n",
    "\n",
    "# GridSearchCV setup\n",
    "grid_search_z = GridSearchCV(\n",
    "    estimator=rf_grid_z,\n",
    "    param_grid=param_grid_z,\n",
    "    cv=5,                # 5-fold cross validation\n",
    "    n_jobs=-1,           # Use all CPU cores\n",
    "    scoring='accuracy',  # Optimize for accuracy\n",
    "    verbose=2\n",
    ")\n",
    "\n",
    "# Run grid search\n",
    "grid_search_z.fit(X_train_z_enc, y_train_z)\n",
    "\n",
    "# Best parameters and score\n",
    "print(\"Best Parameters found by Grid Search (Zone-based):\")\n",
    "print(grid_search_z.best_params_)\n",
    "\n",
    "print(f\"\\nBest Cross-Validation Accuracy: {grid_search_z.best_score_:.4f}\")\n",
    "\n",
    "# Evaluate best model on test set\n",
    "best_rf_z = grid_search_z.best_estimator_\n",
    "y_pred_best_z = best_rf_z.predict(X_test_z_enc)\n",
